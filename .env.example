# Supabase — crée un projet sur https://supabase.com (ou lance-le en local
# avec `npx supabase start`, valeurs par défaut ci-dessous) et applique le
# schéma avec `npx supabase db push` (ou `npx supabase db reset` en local).
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Génération des tests et des portraits via l'API Claude. Sans clé, les
# tests non pré-écrits du catalogue et les thèmes personnalisés ne peuvent
# pas être générés (les tests pré-écrits, eux, restent jouables).
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
