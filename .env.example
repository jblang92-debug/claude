# Base de données (SQLite en local ; voir README pour la production)
DATABASE_URL="file:./prisma/dev.db"

# Optionnel : sans clé, l'app fonctionne quand même grâce à une banque de
# questions et de portraits prête à l'emploi (mode "template"). Avec une
# clé, chaque test et chaque portrait sont générés dynamiquement par Claude.
ANTHROPIC_API_KEY=""

# Optionnel : modèle Claude à utiliser pour la génération (par défaut claude-sonnet-5)
# ANTHROPIC_MODEL="claude-sonnet-5"

# Optionnel : force l'URL de base utilisée pour générer les liens partageables
# (sinon déduite automatiquement de la requête entrante)
# NEXT_PUBLIC_BASE_URL="https://mon-app.example.com"
